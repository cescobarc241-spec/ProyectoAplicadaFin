<UserControl x:Class="HotelGestion.UI.Views.FacturacionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="900"
             MinHeight="650">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <!-- TÍTULO -->
            <RowDefinition Height="Auto"/>

            <!-- ESPACIO -->
            <RowDefinition Height="10"/>

            <!-- CHECK-OUT -->
            <RowDefinition Height="Auto"/>

            <!-- ESPACIO -->
            <RowDefinition Height="10"/>

            <!-- CONTENIDO -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- TÍTULO -->
        <!-- ===================================================== -->

        <StackPanel Grid.Row="0">

            <TextBlock Text="Facturación"
                       FontSize="28"
                       FontWeight="SemiBold"/>

            <TextBlock Text="Administración de facturas y proceso de Check-Out"
                       FontSize="14"
                       Foreground="Gray"
                       Margin="0,5,0,0"/>

        </StackPanel>


        <!-- ===================================================== -->
        <!-- CHECK-OUT -->
        <!-- ===================================================== -->

        <Border Grid.Row="2"
                Background="#F5F7FA"
                BorderBrush="#D9DEE7"
                BorderThickness="1"
                CornerRadius="10"
                Padding="18">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>


                <!-- TÍTULO CHECK-OUT -->

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center"
                            Margin="0,0,15,0">

                    <TextBlock Text="Check-Out"
                               FontSize="18"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Cerrar estancia"
                               FontSize="12"
                               Foreground="Gray"
                               Margin="0,3,0,0"/>

                </StackPanel>


                <!-- ESTANCIA -->

                <StackPanel Grid.Column="1">

                    <TextBlock Text="Estancia"
                               Margin="0,0,0,5"/>

                    <ComboBox ItemsSource="{Binding Estancias}"
                              DisplayMemberPath="EstanciaId"
                              SelectedValuePath="EstanciaId"
                              SelectedValue="{Binding EstanciaIdCheckOut, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Height="34"/>

                </StackPanel>


                <!-- MÉTODO DE PAGO -->

                <StackPanel Grid.Column="4">

                    <TextBlock Text="Método de pago"
                               Margin="0,0,0,5"/>

                    <ComboBox SelectedValue="{Binding MetodoPagoCheckOut, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              SelectedValuePath="Tag"
                              Height="34">

                        <ComboBoxItem Content="Efectivo"
                                      Tag="Efectivo"/>

                        <ComboBoxItem Content="Tarjeta"
                                      Tag="Tarjeta"/>

                        <ComboBoxItem Content="Transferencia"
                                      Tag="Transferencia"/>

                        <ComboBoxItem Content="Yape"
                                      Tag="Yape"/>

                        <ComboBoxItem Content="Plin"
                                      Tag="Plin"/>

                    </ComboBox>

                </StackPanel>


                <!-- INFORMACIÓN -->

                <TextBlock Grid.Column="6"
                           Text="El Check-Out liquida el minibar, calcula la estadía, genera la factura y cambia la habitación a Limpieza."
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Foreground="Gray"
                           Margin="0,0,20,0"/>


                <!-- BOTÓN -->

                <Button Grid.Column="7"
                        Content="REALIZAR CHECK-OUT"
                        Height="42"
                        FontWeight="SemiBold"
                        Command="{Binding EjecutarCheckOutCommand}"/>

            </Grid>

        </Border>


        <!-- ===================================================== -->
        <!-- CONTENIDO PRINCIPAL -->
        <!-- ===================================================== -->

        <Grid Grid.Row="4">

            <Grid.RowDefinitions>
                <RowDefinition Height="1.5*"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- FACTURAS -->
            <!-- ================================================= -->

            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- TABLA FACTURAS -->

                <Border Grid.Column="0"
                        BorderBrush="LightGray"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>


                        <Button Grid.Row="0"
                                Content="Actualizar lista"
                                Width="130"
                                Height="35"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,10"
                                Command="{Binding CargarCommand}"/>


                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Facturas}"
                                  SelectedItem="{Binding FacturaSeleccionada}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  SelectionMode="Single">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="ID"
                                                    Binding="{Binding FacturaId}"
                                                    Width="55"/>

                                <DataGridTextColumn Header="Estancia"
                                                    Binding="{Binding EstanciaId}"
                                                    Width="75"/>

                                <DataGridTextColumn Header="N° Factura"
                                                    Binding="{Binding NumeroFactura}"
                                                    Width="150"/>

                                <DataGridTextColumn Header="Emisión"
                                                    Binding="{Binding FechaEmision, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                                    Width="135"/>

                                <DataGridTextColumn Header="Total"
                                                    Binding="{Binding Total, StringFormat={}{0:F2}}"
                                                    Width="80"/>

                                <DataGridTextColumn Header="Pago"
                                                    Binding="{Binding MetodoPago}"
                                                    Width="100"/>

                                <DataGridTextColumn Header="Estado"
                                                    Binding="{Binding Estado}"
                                                    Width="90"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Grid>

                </Border>


                <!-- FORMULARIO FACTURA -->

                <Border Grid.Column="2"
                        BorderBrush="LightGray"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                        <StackPanel>

                            <TextBlock Text="Datos de la factura"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,20"/>


                            <!-- ESTANCIA -->

                            <TextBlock Text="Estancia"
                                       Margin="0,0,0,5"/>

                            <ComboBox ItemsSource="{Binding Estancias}"
                                      DisplayMemberPath="EstanciaId"
                                      SelectedValuePath="EstanciaId"
                                      SelectedValue="{Binding EstanciaId}"
                                      IsEnabled="False"
                                      Height="32"
                                      Margin="0,0,0,15"/>   


                            <!-- NÚMERO -->

                            <TextBlock Text="Número de factura"
                                       Margin="0,0,0,5"/>

                            <TextBox Text="{Binding NumeroFactura}"
                                     IsReadOnly="True"
                                     Height="32"
                                     Margin="0,0,0,15"/>


                            <!-- FECHA -->

                            <TextBlock Text="Fecha de emisión"
                                       Margin="0,0,0,5"/>

                            <DatePicker SelectedDate="{Binding FechaEmision}"
                                    IsEnabled="False"
                                    Height="32"
                                    Margin="0,0,0,15"/>


                            <!-- SUBTOTAL -->

                            <TextBlock Text="Subtotal"
                                       Margin="0,0,0,5"/>

                            <TextBox Text="{Binding Subtotal}"
                                     IsReadOnly="True"
                                     Height="32"
                                     Margin="0,0,0,15"/>


                            <!-- IMPUESTO -->

                            <TextBlock Text="Impuesto"
                                       Margin="0,0,0,5"/>

                            <TextBox Text="{Binding Impuesto}"
                                     IsReadOnly="True"
                                     Height="32"
                                     Margin="0,0,0,15"/>


                            <!-- TOTAL -->

                            <TextBlock Text="Total"
                                       Margin="0,0,0,5"/>

                            <TextBox Text="{Binding Total}"
                                     IsReadOnly="True"
                                     Height="32"
                                     Margin="0,0,0,15"/>


                            <!-- MÉTODO -->

                            <TextBlock Text="Método de pago"
                                       Margin="0,0,0,5"/>

                            <ComboBox SelectedValue="{Binding MetodoPago}"
                                      SelectedValuePath="Tag"
                                      IsEnabled="False"
                                      Height="32"
                                      Margin="0,0,0,15">

                                <ComboBoxItem Content="Efectivo"
                                              Tag="Efectivo"/>

                                <ComboBoxItem Content="Tarjeta"
                                              Tag="Tarjeta"/>

                                <ComboBoxItem Content="Transferencia"
                                              Tag="Transferencia"/>

                                <ComboBoxItem Content="Yape"
                                              Tag="Yape"/>

                                <ComboBoxItem Content="Plin"
                                              Tag="Plin"/>

                            </ComboBox>


                            <!-- ESTADO -->

                            <TextBlock Text="Estado"
                                       Margin="0,0,0,5"/>

                            <ComboBox SelectedValue="{Binding Estado}"
                                      SelectedValuePath="Tag"
                                      IsEnabled="False"
                                      Height="32"
                                      Margin="0,0,0,20">

                                <ComboBoxItem Content="Emitida"
                                              Tag="Emitida"/>

                                <ComboBoxItem Content="Anulada"
                                              Tag="Anulada"/>

                            </ComboBox>


                            <!-- BOTONES -->

                            <Button Content="Ver detalle"
                                    Height="38"
                                    Margin="0,0,0,8"
                                    Command="{Binding VerDetalleCommand}"/>

                        </StackPanel>

                    </ScrollViewer>

                </Border>

            </Grid>


            <!-- ================================================= -->
            <!-- DETALLES -->
            <!-- ================================================= -->

            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- TABLA DETALLES -->

                <Border Grid.Column="0"
                        BorderBrush="LightGray"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>


                        <TextBlock Grid.Row="0"
                                   Text="Detalles de la factura seleccionada"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>


                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Detalles}"
                                  SelectedItem="{Binding DetalleSeleccionado}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  SelectionMode="Single">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="ID"
                                                    Binding="{Binding DetalleFacturaId}"
                                                    Width="55"/>

                                <DataGridTextColumn Header="Descripción"
                                                    Binding="{Binding Descripcion}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="Cantidad"
                                                    Binding="{Binding Cantidad}"
                                                    Width="75"/>

                                <DataGridTextColumn Header="Precio"
                                                    Binding="{Binding PrecioUnitario, StringFormat={}{0:F2}}"
                                                    Width="80"/>

                                <DataGridTextColumn Header="Subtotal"
                                                    Binding="{Binding Subtotal, StringFormat={}{0:F2}}"
                                                    Width="85"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Grid>

                </Border>


                <!-- FORMULARIO DETALLE -->

                <Border Grid.Column="2"
                        BorderBrush="LightGray"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                        <StackPanel>

                            <TextBlock Text="Detalle"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,20"/>


                            <!-- DESCRIPCIÓN -->

                            <TextBlock Text="Descripción"
                                       Margin="0,0,0,5"/>

                            <TextBox Text="{Binding Descripcion}"
                                     IsReadOnly="True"
                                     Height="32"
                                     Margin="0,0,0,15"/>


                            <!-- CANTIDAD -->

                            <TextBlock Text="Cantidad"
                                       Margin="0,0,0,5"/>

                            <TextBox Text="{Binding Cantidad}"
                                     IsReadOnly="True"
                                     Height="32"
                                     Margin="0,0,0,15"/>


                            <!-- PRECIO -->

                            <TextBlock Text="Precio unitario"
                                       Margin="0,0,0,5"/>

                            <TextBox Text="{Binding PrecioUnitario}"
                                     IsReadOnly="True"
                                     Height="32"
                                     Margin="0,0,0,15"/>


                            <!-- SUBTOTAL -->

                            <TextBlock Text="Subtotal"
                                       Margin="0,0,0,5"/>

                            <TextBox Text="{Binding SubtotalDetalle}"
                                     IsReadOnly="True"
                                     Height="32"
                                     Margin="0,0,0,15"/>

                        </StackPanel>

                    </ScrollViewer>

                </Border>

            </Grid>

        </Grid>

    </Grid>

</UserControl>