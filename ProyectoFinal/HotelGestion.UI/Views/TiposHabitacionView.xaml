<UserControl x:Class="HotelGestion.UI.Views.TiposHabitacionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="700"
             MinHeight="500">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TÍTULO -->
        <StackPanel Grid.Row="0">

            <TextBlock Text="Tipos de habitación"
                       FontSize="28"
                       FontWeight="SemiBold"/>

            <TextBlock Text="Administración de los tipos de habitación del hotel"
                       FontSize="14"
                       Foreground="Gray"
                       Margin="0,5,0,0"/>

        </StackPanel>

        <!-- CONTENIDO -->
        <Grid Grid.Row="2"
              Margin="0,15,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- TABLA -->
            <Border Grid.Column="0"
                    BorderBrush="LightGray"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0"
                            Content="Actualizar lista"
                            Width="130"
                            Height="35"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,10"
                            Command="{Binding CargarCommand}"/>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding TiposHabitacion}"
                              SelectedItem="{Binding TipoSeleccionado}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="ID"
                                                Binding="{Binding TipoHabitacionId}"
                                                Width="55"/>

                            <DataGridTextColumn Header="Nombre"
                                                Binding="{Binding Nombre}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Capacidad"
                                                Binding="{Binding Capacidad}"
                                                Width="90"/>

                            <DataGridTextColumn Header="Precio/Noche"
                                                Binding="{Binding PrecioPorNoche, StringFormat={}{0:F2}}"
                                                Width="100"/>

                            <DataGridTextColumn Header="Descripción"
                                                Binding="{Binding Descripcion}"
                                                Width="*"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>

            <!-- FORMULARIO -->
            <Border Grid.Column="2"
                    BorderBrush="LightGray"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <TextBlock Text="Datos del tipo"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,20"/>

                        <TextBlock Text="Nombre"
                                   Margin="0,0,0,5"/>

                        <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"
                                 Height="32"
                                 Margin="0,0,0,15"/>

                        <TextBlock Text="Capacidad"
                                   Margin="0,0,0,5"/>

                        <TextBox Text="{Binding Capacidad, UpdateSourceTrigger=PropertyChanged}"
                                 Height="32"
                                 Margin="0,0,0,15"/>

                        <TextBlock Text="Precio por noche"
                                   Margin="0,0,0,5"/>

                        <TextBox Text="{Binding PrecioPorNoche, UpdateSourceTrigger=PropertyChanged}"
                                 Height="32"
                                 Margin="0,0,0,15"/>

                        <TextBlock Text="Descripción"
                                   Margin="0,0,0,5"/>

                        <TextBox Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}"
                                 Height="80"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,0,0,20"/>

                        <Button Content="Nuevo tipo"
                                Height="38"
                                Margin="0,0,0,8"
                                Command="{Binding NuevoCommand}"/>

                        <Button Content="Guardar"
                                Height="38"
                                Margin="0,0,0,8"
                                Command="{Binding GuardarCommand}"/>

                        <Button Content="Actualizar"
                                Height="38"
                                Margin="0,0,0,8"
                                Command="{Binding ActualizarCommand}"/>

                        <Button Content="Eliminar"
                                Height="38"
                                Command="{Binding EliminarCommand}"/>

                    </StackPanel>

                </ScrollViewer>

            </Border>

        </Grid>

    </Grid>

</UserControl>