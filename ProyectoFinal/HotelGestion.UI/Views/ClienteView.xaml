<UserControl x:Class="HotelGestion.UI.Views.ClienteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="900"
             MinHeight="600">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================================================= -->
        <!-- TÍTULO -->
        <!-- ================================================= -->

        <StackPanel Grid.Row="0">

            <TextBlock Text="Clientes"
                       FontSize="28"
                       FontWeight="SemiBold"/>

            <TextBlock Text="Registro y administración de clientes"
                       FontSize="14"
                       Foreground="Gray"
                       Margin="0,5,0,0"/>

        </StackPanel>

        <!-- ================================================= -->
        <!-- CONTENIDO -->
        <!-- ================================================= -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================================================= -->
            <!-- LISTA -->
            <!-- ================================================= -->

            <Border Grid.Column="0"
                    BorderBrush="LightGray"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0"
                            Content="Actualizar lista"
                            Width="130"
                            Height="35"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,10"
                            Command="{Binding CargarCommand}"/>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Clientes}"
                              SelectedItem="{Binding ClienteSeleccionado}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="ID"
                                                Binding="{Binding ClienteId}"
                                                Width="55"/>

                            <DataGridTextColumn Header="Documento"
                                                Binding="{Binding TipoDocumento}"
                                                Width="100"/>

                            <DataGridTextColumn Header="N° Documento"
                                                Binding="{Binding NumeroDocumento}"
                                                Width="120"/>

                            <DataGridTextColumn Header="Nombres"
                                                Binding="{Binding Nombres}"
                                                Width="140"/>

                            <DataGridTextColumn Header="Apellidos"
                                                Binding="{Binding Apellidos}"
                                                Width="160"/>

                            <DataGridTextColumn Header="Teléfono"
                                                Binding="{Binding Telefono}"
                                                Width="100"/>

                            <DataGridTextColumn Header="Correo"
                                                Binding="{Binding Correo}"
                                                Width="180"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>

            <!-- ================================================= -->
            <!-- FORMULARIO -->
            <!-- ================================================= -->

            <Border Grid.Column="2"
                    BorderBrush="LightGray"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <TextBlock Text="Datos del cliente"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,20"/>

                        <!-- TIPO DOCUMENTO -->

                        <TextBlock Text="Tipo de documento"
                                   Margin="0,0,0,5"/>

                        <ComboBox SelectedValue="{Binding TipoDocumento, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Tag"
                                  Height="32"
                                  Margin="0,0,0,15">

                            <ComboBoxItem Content="DNI"
                                          Tag="DNI"/>

                            <ComboBoxItem Content="CE"
                                          Tag="CE"/>

                            <ComboBoxItem Content="Pasaporte"
                                          Tag="Pasaporte"/>

                        </ComboBox>

                        <!-- NÚMERO -->

                        <TextBlock Text="Número de documento"
                                   Margin="0,0,0,5"/>

                        <TextBox Text="{Binding NumeroDocumento, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Height="32"
                                 Margin="0,0,0,15"/>

                        <!-- NOMBRES -->

                        <TextBlock Text="Nombres"
                                   Margin="0,0,0,5"/>

                        <TextBox Text="{Binding Nombres, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Height="32"
                                 Margin="0,0,0,15"/>

                        <!-- APELLIDOS -->

                        <TextBlock Text="Apellidos"
                                   Margin="0,0,0,5"/>

                        <TextBox Text="{Binding Apellidos, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Height="32"
                                 Margin="0,0,0,15"/>

                        <!-- TELÉFONO -->

                        <TextBlock Text="Teléfono"
                                   Margin="0,0,0,5"/>

                        <TextBox Text="{Binding Telefono, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Height="32"
                                 Margin="0,0,0,15"/>

                        <!-- CORREO -->

                        <TextBlock Text="Correo"
                                   Margin="0,0,0,5"/>

                        <TextBox Text="{Binding Correo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Height="32"
                                 Margin="0,0,0,15"/>

                        <!-- DIRECCIÓN -->

                        <TextBlock Text="Dirección"
                                   Margin="0,0,0,5"/>

                        <TextBox Text="{Binding Direccion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Height="65"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Margin="0,0,0,20"/>

                        <!-- BOTONES -->

                        <Button Content="Nuevo cliente"
                                Height="38"
                                Margin="0,0,0,8"
                                Command="{Binding NuevoCommand}"/>

                        <Button Content="Guardar"
                                Height="38"
                                Margin="0,0,0,8"
                                Command="{Binding GuardarCommand}"/>

                        <Button Content="Actualizar"
                                Height="38"
                                Margin="0,0,0,8"
                                Command="{Binding ActualizarCommand}"/>

                        <Button Content="Eliminar"
                                Height="38"
                                Command="{Binding EliminarCommand}"/>

                    </StackPanel>

                </ScrollViewer>

            </Border>

        </Grid>

    </Grid>

</UserControl>