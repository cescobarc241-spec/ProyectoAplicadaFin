<UserControl x:Class="HotelGestion.UI.Views.CheckInView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F6FA">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- =========================================================
             TÍTULO
             ========================================================= -->

        <StackPanel Grid.Row="0">

            <TextBlock Text="Check-In"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="#222222"/>

            <TextBlock Text="Registro de ingreso del huésped"
                       FontSize="14"
                       Foreground="#666666"
                       Margin="0,5,0,0"/>

        </StackPanel>


        <!-- =========================================================
             CONTENIDO
             ========================================================= -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- =====================================================
                 RESERVAS
                 ===================================================== -->

            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <!-- ENCABEZADO -->

                    <DockPanel Grid.Row="0">

                        <StackPanel DockPanel.Dock="Left">

                            <TextBlock Text="Reservas disponibles"
                                       FontSize="20"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="Seleccione una reserva para realizar el Check-In."
                                       Foreground="#777777"
                                       Margin="0,5,0,0"/>

                        </StackPanel>

                        <Button DockPanel.Dock="Right"
                                Content="Actualizar"
                                Width="100"
                                Height="34"
                                Command="{Binding CargarCommand}"/>

                    </DockPanel>


                    <!-- LISTA DE RESERVAS -->

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding Reservas}"
                              SelectedItem="{Binding ReservaSeleccionada}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="ID"
                                                Binding="{Binding ReservaId}"
                                                Width="55"/>

                            <DataGridTextColumn Header="Cliente"
                                                Binding="{Binding ClienteId}"
                                                Width="80"/>

                            <DataGridTextColumn Header="Habitación"
                                                Binding="{Binding HabitacionId}"
                                                Width="90"/>

                            <DataGridTextColumn Header="Entrada"
                                                Binding="{Binding FechaEntrada, StringFormat={}{0:dd/MM/yyyy}}"
                                                Width="100"/>

                            <DataGridTextColumn Header="Salida"
                                                Binding="{Binding FechaSalida, StringFormat={}{0:dd/MM/yyyy}}"
                                                Width="100"/>

                            <DataGridTextColumn Header="Huéspedes"
                                                Binding="{Binding CantidadHuespedes}"
                                                Width="80"/>

                            <DataGridTextColumn Header="Estado"
                                                Binding="{Binding Estado}"
                                                Width="100"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>


            <!-- =====================================================
                 FORMULARIO
                 ===================================================== -->

            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <TextBlock Text="Datos del Check-In"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,20"/>


                        <!-- =================================================
                             MODO
                             ================================================= -->

                        <TextBlock Text="Modalidad"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                        <CheckBox Content="Cliente con reserva"
                                  IsChecked="{Binding ConReserva, UpdateSourceTrigger=PropertyChanged}"
                                  FontSize="14"
                                  Margin="0,0,0,20"/>


                        <!-- =================================================
                             RESERVA
                             ================================================= -->

                        <TextBlock Text="Reserva"
                                   Margin="0,0,0,5"/>

                        <ComboBox ItemsSource="{Binding Reservas}"
                                  SelectedItem="{Binding ReservaSeleccionada}"
                                  DisplayMemberPath="ReservaId"
                                  Height="32"
                                  Margin="0,0,0,15">

                            <ComboBox.Style>

                                <Style TargetType="ComboBox">

                                    <Setter Property="IsEnabled"
                                            Value="True"/>

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding ConReserva}"
                                                     Value="False">

                                            <Setter Property="IsEnabled"
                                                    Value="False"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </ComboBox.Style>

                        </ComboBox>


                        <!-- =================================================
                             CLIENTE
                             ================================================= -->

                        <TextBlock Text="Cliente"
                                   Margin="0,0,0,5"/>

                        <ComboBox ItemsSource="{Binding Clientes}"
                                  SelectedValuePath="ClienteId"
                                  SelectedValue="{Binding ClienteId, UpdateSourceTrigger=PropertyChanged}"
                                  Height="32"
                                  Margin="0,0,0,15">

                            <ComboBox.ItemTemplate>

                                <DataTemplate>

                                    <TextBlock>

                                        <Run Text="{Binding Nombres}"/>

                                        <Run Text=" "/>

                                        <Run Text="{Binding Apellidos}"/>

                                        <Run Text=" - "/>

                                        <Run Text="{Binding NumeroDocumento}"/>

                                    </TextBlock>

                                </DataTemplate>

                            </ComboBox.ItemTemplate>

                            <ComboBox.Style>

                                <Style TargetType="ComboBox">

                                    <Setter Property="IsEnabled"
                                            Value="True"/>

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding ConReserva}"
                                                     Value="True">

                                            <Setter Property="IsEnabled"
                                                    Value="False"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </ComboBox.Style>

                        </ComboBox>


                        <!-- =================================================
                             HABITACIÓN
                             ================================================= -->

                        <TextBlock Text="Habitación"
                                   Margin="0,0,0,5"/>

                        <ComboBox ItemsSource="{Binding Habitaciones}"
                                  DisplayMemberPath="NombreCompleto"
                                  SelectedItem="{Binding HabitacionSeleccionada, Mode=TwoWay}"
                                  Height="32"
                                  Margin="0,0,0,15">

                            <ComboBox.Style>

                                <Style TargetType="ComboBox">

                                    <Setter Property="IsEnabled"
                                            Value="True"/>

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding ConReserva}"
                                                     Value="True">

                                            <Setter Property="IsEnabled"
                                                    Value="False"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </ComboBox.Style>

                        </ComboBox>


                        <!-- =================================================
                             FECHA CHECK-IN
                             ================================================= -->

                        <TextBlock Text="Fecha de Check-In"
                                   Margin="0,0,0,5"/>

                        <DatePicker SelectedDate="{Binding FechaCheckIn}"
                                    Height="32"
                                    Margin="0,0,0,15"/>


                        <!-- =================================================
                             FECHA SALIDA
                             ================================================= -->

                        <TextBlock Text="Fecha de salida"
                                   Margin="0,0,0,5"/>

                        <DatePicker SelectedDate="{Binding FechaSalida}"
                                    Height="32"
                                    Margin="0,0,0,15"/>


                        <!-- =================================================
                             HUÉSPEDES
                             ================================================= -->

                        <TextBlock Text="Cantidad de huéspedes"
                                   Margin="0,0,0,5"/>

                        <TextBox Text="{Binding CantidadHuespedes, UpdateSourceTrigger=PropertyChanged}"
                                 Height="32"
                                 Margin="0,0,0,15"/>


                        <!-- =================================================
                             OBSERVACIONES
                             ================================================= -->

                        <TextBlock Text="Observaciones"
                                   Margin="0,0,0,5"/>

                        <TextBox Text="{Binding Observaciones, UpdateSourceTrigger=PropertyChanged}"
                                 Height="70"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Margin="0,0,0,20"/>


                        <!-- =================================================
                             BOTONES
                             ================================================= -->

                        <Button Content="Registrar Check-In"
                                Height="42"
                                FontWeight="SemiBold"
                                Command="{Binding EjecutarCheckInCommand}"
                                Margin="0,0,0,10"/>

                        <Button Content="Nuevo Check-In"
                                Height="38"
                                Click="NuevoCheckIn_Click"/>

                    </StackPanel>

                </ScrollViewer>

            </Border>

        </Grid>

    </Grid>

</UserControl>