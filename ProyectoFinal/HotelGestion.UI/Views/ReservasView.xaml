<UserControl x:Class="HotelGestion.UI.Views.ReservasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="700"
             MinHeight="500">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TÍTULO -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Reservas"
                       FontSize="28"
                       FontWeight="SemiBold"/>

            <TextBlock Text="Registra y administra las reservas del hotel"
                       FontSize="14"
                       Foreground="Gray"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- ACCIONES -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal">

            <Button Content="Actualizar lista"
                    Width="130"
                    Height="35"
                    Command="{Binding CargarCommand}"/>

        </StackPanel>

        <!-- TABLA -->
        <Border Grid.Row="4"
                BorderBrush="LightGray"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10">

            <DataGrid ItemsSource="{Binding Reservas}"
                      SelectedItem="{Binding ReservaSeleccionada}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding ReservaId}"
                                        Width="55"/>

                    <DataGridTextColumn Header="Cliente"
                                        Binding="{Binding ClienteId}"
                                        Width="70"/>

                    <DataGridTextColumn Header="Habitación"
                                        Binding="{Binding HabitacionId}"
                                        Width="90"/>

                    <DataGridTextColumn Header="Entrada"
                                        Binding="{Binding FechaEntrada, StringFormat={}{0:dd/MM/yyyy}}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Salida"
                                        Binding="{Binding FechaSalida, StringFormat={}{0:dd/MM/yyyy}}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Huéspedes"
                                        Binding="{Binding CantidadHuespedes}"
                                        Width="80"/>

                    <DataGridTextColumn Header="Estado"
                                        Binding="{Binding Estado}"
                                        Width="110"/>

                    <DataGridTextColumn Header="Observaciones"
                                        Binding="{Binding Observaciones}"
                                        Width="*"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

        <!-- FORMULARIO -->
        <Border Grid.Row="6"
                BorderBrush="LightGray"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- CLIENTE -->
                <StackPanel Grid.Column="0"
                            Grid.Row="0">

                    <TextBlock Text="Cliente"
                               Margin="0,0,0,5"/>

                    <ComboBox ItemsSource="{Binding Clientes}"
                      SelectedValuePath="ClienteId"
                      SelectedValue="{Binding ClienteId, UpdateSourceTrigger=PropertyChanged}"
                      Height="32">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock> 
                                <Run Text="{Binding Nombres}"/>
                                <Run Text=" "/>
                                <Run Text="{Binding Apellidos}"/>
                                <Run Text=" - "/>
                                <Run Text="{Binding NumeroDocumento}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                </StackPanel>

                <!-- HABITACIÓN -->
                <StackPanel Grid.Column="2"
                            Grid.Row="0">

                    <TextBlock Text="Habitación"
                               Margin="0,0,0,5"/>

                    <ComboBox ItemsSource="{Binding Habitaciones}"
                          DisplayMemberPath="NombreCompleto"
                          SelectedValuePath="HabitacionId"
                          SelectedValue="{Binding HabitacionId, UpdateSourceTrigger=PropertyChanged}"
                          Height="32"/> 

                </StackPanel>

                <!-- CANTIDAD DE HUÉSPEDES -->
                <StackPanel Grid.Column="4"
                            Grid.Row="0">

                    <TextBlock Text="Huéspedes"
                               Margin="0,0,0,5"/>

                    <TextBox Text="{Binding CantidadHuespedes, UpdateSourceTrigger=PropertyChanged}"
                             Height="32"/>

                </StackPanel>

                <!-- FECHA ENTRADA -->
                <StackPanel Grid.Column="0"
                            Grid.Row="2">

                    <TextBlock Text="Fecha de entrada"
                               Margin="0,0,0,5"/>

                    <DatePicker SelectedDate="{Binding FechaEntrada}"
                                Height="32"/>

                </StackPanel>

                <!-- FECHA SALIDA -->
                <StackPanel Grid.Column="2"
                            Grid.Row="2">

                    <TextBlock Text="Fecha de salida"
                               Margin="0,0,0,5"/>

                    <DatePicker SelectedDate="{Binding FechaSalida}"
                                Height="32"/>

                </StackPanel>

                <!-- ESTADO -->
                <StackPanel Grid.Column="4"
                            Grid.Row="2">

                    <TextBlock Text="Estado"
                               Margin="0,0,0,5"/>

                    <ComboBox SelectedValue="{Binding Estado, UpdateSourceTrigger=PropertyChanged}"
                              SelectedValuePath="Tag"
                              Height="32">

                        <ComboBoxItem Content="Pendiente"
                                      Tag="Pendiente"/>

                        <ComboBoxItem Content="Confirmada"
                                      Tag="Confirmada"/>

                        <ComboBoxItem Content="Cancelada"
                                      Tag="Cancelada"/>

                        <ComboBoxItem Content="Completada"
                                      Tag="Completada"/>

                    </ComboBox>

                </StackPanel>

                <!-- FECHA RESERVA -->
                <StackPanel Grid.Column="0"
                            Grid.Row="4">

                    <TextBlock Text="Fecha de reserva"
                               Margin="0,0,0,5"/>

                    <DatePicker SelectedDate="{Binding FechaReserva}"
                                Height="32"/>

                </StackPanel>

                <!-- OBSERVACIONES -->
                <StackPanel Grid.Column="2"
                            Grid.ColumnSpan="3"
                            Grid.Row="4">

                    <TextBlock Text="Observaciones"
                               Margin="0,0,0,5"/>

                    <TextBox Text="{Binding Observaciones, UpdateSourceTrigger=PropertyChanged}"
                             Height="60"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"/>

                </StackPanel>

                <!-- BOTONES -->
                <StackPanel Grid.Column="0"
                            Grid.ColumnSpan="5"
                            Grid.Row="8"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <Button Content="Nueva reserva"
                            Width="130"
                            Height="38"
                            Margin="5"
                            Command="{Binding NuevoCommand}"/>

                    <Button Content="Guardar"
                            Width="110"
                            Height="38"
                            Margin="5"
                            Command="{Binding GuardarCommand}"/>

                    <Button Content="Actualizar"
                            Width="110"
                            Height="38"
                            Margin="5"
                            Command="{Binding ActualizarCommand}"/>

                    <Button Content="Eliminar"
                            Width="110"
                            Height="38"
                            Margin="5"
                            Command="{Binding EliminarCommand}"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</UserControl>