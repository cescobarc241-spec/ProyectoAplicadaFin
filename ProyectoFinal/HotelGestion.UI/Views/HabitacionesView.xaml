<UserControl x:Class="HotelGestion.UI.Views.HabitacionesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="750"
             MinHeight="500">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TÍTULO -->
        <StackPanel Grid.Row="0">

            <TextBlock Text="Habitaciones"
                       FontSize="28"
                       FontWeight="SemiBold"/>

            <TextBlock Text="Administración de las habitaciones del hotel"
                       FontSize="14"
                       Foreground="Gray"
                       Margin="0,5,0,0"/>

        </StackPanel>

        <Grid Grid.Row="2"
              Margin="0,15,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- TABLA -->
            <Border Grid.Column="0"
                    BorderBrush="LightGray"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0"
                            Content="Actualizar lista"
                            Width="130"
                            Height="35"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,10"
                            Command="{Binding CargarCommand}"/>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Habitaciones}"
                              SelectedItem="{Binding HabitacionSeleccionada}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="ID"
                                                Binding="{Binding HabitacionId}"
                                                Width="55"/>

                            <DataGridTextColumn Header="Número"
                                                Binding="{Binding Numero}"
                                                Width="80"/>

                            <DataGridTextColumn Header="Piso"
                                                Binding="{Binding Piso}"
                                                Width="60"/>

                            <DataGridTextColumn Header="Tipo"
                                                Binding="{Binding TipoHabitacionId}"
                                                Width="70"/>

                            <DataGridTextColumn Header="Estado"
                                                Binding="{Binding Estado}"
                                                Width="120"/>

                            <DataGridTextColumn Header="Descripción"
                                                Binding="{Binding Descripcion}"
                                                Width="*"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>

            <!-- FORMULARIO -->
            <Border Grid.Column="2"
                    BorderBrush="LightGray"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <TextBlock Text="Datos de la habitación"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,20"/>

                        <TextBlock Text="Número"
                                   Margin="0,0,0,5"/>

                        <TextBox Text="{Binding Numero, UpdateSourceTrigger=PropertyChanged}"
                                 Height="32"
                                 Margin="0,0,0,15"/>

                        <TextBlock Text="Piso"
                                   Margin="0,0,0,5"/>

                        <TextBox Text="{Binding Piso, UpdateSourceTrigger=PropertyChanged}"
                                 Height="32"
                                 Margin="0,0,0,15"/>

                        <TextBlock Text="Tipo de habitación"
                                   Margin="0,0,0,5"/>

                        <ComboBox ItemsSource="{Binding TiposHabitacion}"
                                  DisplayMemberPath="Nombre"
                                  SelectedValuePath="TipoHabitacionId"
                                  SelectedValue="{Binding TipoHabitacionId, UpdateSourceTrigger=PropertyChanged}"
                                  Height="32"
                                  Margin="0,0,0,15"/>

                        <TextBlock Text="Estado"
                                   Margin="0,0,0,5"/>

                        <ComboBox SelectedValue="{Binding Estado, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Tag"
                                  Height="32"
                                  Margin="0,0,0,15">

                            <ComboBoxItem Content="Disponible"
                                          Tag="Disponible"/>

                            <ComboBoxItem Content="Reservada"
                                          Tag="Reservada"/>

                            <ComboBoxItem Content="Ocupada"
                                          Tag="Ocupada"/>

                            <ComboBoxItem Content="Limpieza"
                                          Tag="Limpieza"/>

                            <ComboBoxItem Content="Mantenimiento"
                                          Tag="Mantenimiento"/>

                        </ComboBox>

                        <TextBlock Text="Descripción"
                                   Margin="0,0,0,5"/>

                        <TextBox Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}"
                                 Height="80"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,0,0,20"/>

                        <Button Content="Nueva habitación"
                                Height="38"
                                Margin="0,0,0,8"
                                Command="{Binding NuevoCommand}"/>

                        <Button Content="Guardar"
                                Height="38"
                                Margin="0,0,0,8"
                                Command="{Binding GuardarCommand}"/>

                        <Button Content="Actualizar"
                                Height="38"
                                Margin="0,0,0,8"
                                Command="{Binding ActualizarCommand}"/>

                        <Button Content="Eliminar"
                                Height="38"
                                Command="{Binding EliminarCommand}"/>

                    </StackPanel>

                </ScrollViewer>

            </Border>

        </Grid>

    </Grid>

</UserControl>