<UserControl x:Class="HotelGestion.UI.Views.MinibarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="750"
             MinHeight="550">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TÍTULO -->
        <StackPanel Grid.Row="0">

            <TextBlock Text="Minibar"
                       FontSize="28"
                       FontWeight="SemiBold"/>

            <TextBlock Text="Administración de productos y consumos del minibar"
                       FontSize="14"
                       Foreground="Gray"
                       Margin="0,5,0,0"/>

        </StackPanel>

        <!-- CONTENIDO -->
        <TabControl Grid.Row="2"
                    Margin="0,15,0,0">

            <!-- ===================================================== -->
            <!-- PRODUCTOS -->
            <!-- ===================================================== -->

            <TabItem Header="Productos">

                <Grid Margin="15">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- TABLA PRODUCTOS -->
                    <Border Grid.Column="0"
                            BorderBrush="LightGray"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Button Grid.Row="0"
                                    Content="Actualizar lista"
                                    Width="130"
                                    Height="35"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,10"
                                    Command="{Binding CargarCommand}"/>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding Productos}"
                                      SelectedItem="{Binding ProductoSeleccionado}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      SelectionMode="Single">

                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="ID"
                                                        Binding="{Binding ProductoMinibarId}"
                                                        Width="55"/>

                                    <DataGridTextColumn Header="Producto"
                                                        Binding="{Binding Nombre}"
                                                        Width="*"/>

                                    <DataGridTextColumn Header="Precio"
                                                        Binding="{Binding Precio, StringFormat={}{0:F2}}"
                                                        Width="80"/>

                                    <DataGridTextColumn Header="Stock"
                                                        Binding="{Binding Stock}"
                                                        Width="70"/>

                                    <DataGridTextColumn Header="Estado"
                                                        Binding="{Binding Estado}"
                                                        Width="90"/>

                                </DataGrid.Columns>

                            </DataGrid>

                        </Grid>

                    </Border>

                    <!-- FORMULARIO PRODUCTO -->
                    <Border Grid.Column="2"
                            BorderBrush="LightGray"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">

                        <ScrollViewer VerticalScrollBarVisibility="Auto">

                            <StackPanel>

                                <TextBlock Text="Datos del producto"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,20"/>

                                <TextBlock Text="Nombre"
                                           Margin="0,0,0,5"/>

                                <TextBox Text="{Binding NombreProducto, UpdateSourceTrigger=PropertyChanged}"
                                         Height="32"
                                         Margin="0,0,0,15"/>

                                <TextBlock Text="Descripción"
                                           Margin="0,0,0,5"/>

                                <TextBox Text="{Binding DescripcionProducto, UpdateSourceTrigger=PropertyChanged}"
                                         Height="65"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Margin="0,0,0,15"/>

                                <TextBlock Text="Precio"
                                           Margin="0,0,0,5"/>

                                <TextBox Text="{Binding PrecioProducto, UpdateSourceTrigger=PropertyChanged}"
                                         Height="32"
                                         Margin="0,0,0,15"/>

                                <TextBlock Text="Stock"
                                           Margin="0,0,0,5"/>

                                <TextBox Text="{Binding StockProducto, UpdateSourceTrigger=PropertyChanged}"
                                         Height="32"
                                         Margin="0,0,0,15"/>

                                <TextBlock Text="Estado"
                                           Margin="0,0,0,5"/>

                                <ComboBox SelectedValue="{Binding EstadoProducto, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Tag"
                                          Height="32"
                                          Margin="0,0,0,20">

                                    <ComboBoxItem Content="Activo"
                                                  Tag="Activo"/>

                                    <ComboBoxItem Content="Inactivo"
                                                  Tag="Inactivo"/>

                                </ComboBox>

                                <Button Content="Nuevo producto"
                                        Height="38"
                                        Margin="0,0,0,8"
                                        Command="{Binding NuevoProductoCommand}"/>

                                <Button Content="Guardar"
                                        Height="38"
                                        Margin="0,0,0,8"
                                        Command="{Binding GuardarProductoCommand}"/>

                                <Button Content="Actualizar"
                                        Height="38"
                                        Margin="0,0,0,8"
                                        Command="{Binding ActualizarProductoCommand}"/>

                                <Button Content="Eliminar"
                                        Height="38"
                                        Command="{Binding EliminarProductoCommand}"/>

                            </StackPanel>

                        </ScrollViewer>

                    </Border>

                </Grid>

            </TabItem>

            <!-- ===================================================== -->
            <!-- CONSUMOS -->
            <!-- ===================================================== -->

            <TabItem Header="Consumos">

                <Grid Margin="15">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ACTUALIZAR -->
                    <Button Grid.Row="0"
                            Content="Actualizar lista"
                            Width="130"
                            Height="35"
                            HorizontalAlignment="Left"
                            Command="{Binding CargarCommand}"/>

                    <!-- TABLA -->
                    <Border Grid.Row="2"
                            BorderBrush="LightGray"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10">

                        <DataGrid ItemsSource="{Binding Consumos}"
                                  SelectedItem="{Binding ConsumoSeleccionado}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  SelectionMode="Single">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="ID"
                                                    Binding="{Binding ConsumoMinibarId}"
                                                    Width="55"/>

                                <DataGridTextColumn Header="Estancia"
                                                    Binding="{Binding EstanciaId}"
                                                    Width="70"/>

                                <DataGridTextColumn Header="Producto"
                                                    Binding="{Binding ProductoMinibarId}"
                                                    Width="75"/>

                                <DataGridTextColumn Header="Cantidad"
                                                    Binding="{Binding Cantidad}"
                                                    Width="75"/>

                                <DataGridTextColumn Header="Precio unit."
                                                    Binding="{Binding PrecioUnitario, StringFormat={}{0:F2}}"
                                                    Width="90"/>

                                <DataGridTextColumn Header="Fecha"
                                                    Binding="{Binding FechaConsumo, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                                    Width="140"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Border>

                    <!-- FORMULARIO CONSUMO -->
                    <Border Grid.Row="4"
                            BorderBrush="LightGray"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="15"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- ESTANCIA -->
                            <StackPanel Grid.Column="0"
                                        Grid.Row="0">

                                <TextBlock Text="Estancia"
                                           Margin="0,0,0,5"/>

                                <ComboBox ItemsSource="{Binding Estancias}"
                                          DisplayMemberPath="EstanciaId"
                                          SelectedValuePath="EstanciaId"
                                          SelectedValue="{Binding EstanciaId, UpdateSourceTrigger=PropertyChanged}"
                                          Height="32"
                                          IsEnabled="{Binding PuedeEditarConsumo}"/>

                            </StackPanel>

                            <!-- PRODUCTO -->
                            <StackPanel Grid.Column="2"
                                        Grid.Row="0">

                                <TextBlock Text="Producto"
                                           Margin="0,0,0,5"/>

                                <ComboBox ItemsSource="{Binding Productos}"
                                          DisplayMemberPath="Nombre"
                                          SelectedValuePath="ProductoMinibarId"
                                          SelectedValue="{Binding ProductoMinibarId, UpdateSourceTrigger=PropertyChanged}"
                                          Height="32"
                                          IsEnabled="{Binding PuedeEditarConsumo}"/>
                            </StackPanel>

                            <!-- CANTIDAD -->
                            <StackPanel Grid.Column="4"
                                        Grid.Row="0">

                                <TextBlock Text="Cantidad"
                                           Margin="0,0,0,5"/>

                                <TextBox Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}"
                                         Height="32"
                                         IsEnabled="{Binding PuedeEditarConsumo}"/>             

                            </StackPanel>

                            <!-- PRECIO -->
                            <StackPanel Grid.Column="6"
                                        Grid.Row="0">

                                <TextBlock Text="Precio unitario"
                                           Margin="0,0,0,5"/>

                                <TextBox Text="{Binding PrecioUnitario, UpdateSourceTrigger=PropertyChanged}"
                                         Height="32"
                                         IsEnabled="{Binding PuedeEditarConsumo}"/>         
                            </StackPanel>

                            <!-- FECHA -->
                            <StackPanel Grid.Column="0"
                                        Grid.ColumnSpan="3"
                                        Grid.Row="2">

                                <TextBlock Text="Fecha de consumo"
                                           Margin="0,0,0,5"/>

                                <DatePicker SelectedDate="{Binding FechaConsumo}"
                                        Height="32"
                                        IsEnabled="{Binding PuedeEditarConsumo}"/>
                            </StackPanel>

                            <!-- BOTONES -->
                            <StackPanel Grid.Column="0"
                                        Grid.ColumnSpan="7"
                                        Grid.Row="4"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center">

                                <Button Content="Nuevo consumo"
                                        Width="130"
                                        Height="38"
                                        Margin="5"
                                        Command="{Binding NuevoConsumoCommand}"/>

                                <Button Content="Guardar"
                                        Width="110"
                                        Height="38"
                                        Margin="5"
                                        Command="{Binding GuardarConsumoCommand}"/>

                                <Button Content="Actualizar"
                                        Width="110"
                                        Height="38"
                                        Margin="5"
                                        Command="{Binding ActualizarConsumoCommand}"/>

                                <Button Content="Eliminar"
                                        Width="110"
                                        Height="38"
                                        Margin="5"
                                        Command="{Binding EliminarConsumoCommand}"/>

                            </StackPanel>

                        </Grid>

                    </Border>

                </Grid>

            </TabItem>

        </TabControl>

    </Grid>

</UserControl>