<Window x:Class="HotelGestion.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hotel Gestión"
        Height="700"
        Width="1200"
        MinHeight="600"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================================================== -->
        <!-- MENÚ LATERAL -->
        <!-- ===================================================== -->

        <Border Grid.Column="0"
                Background="#1F2937">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ENCABEZADO -->
                <StackPanel Grid.Row="0"
                            Margin="25,30,20,25">

                    <TextBlock Text="HOTEL"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="Bold"/>

                    <TextBlock Text="Sistema de Gestión"
                               Foreground="#D1D5DB"
                               FontSize="13"
                               Margin="0,5,0,0"/>

                </StackPanel>

                <!-- OPCIONES -->
                <StackPanel Grid.Row="1"
                            Margin="12,10">

                    <Button Content="Habitaciones"
                            Command="{Binding MostrarHabitacionesCommand}"
                            Height="45"
                            Margin="0,0,0,8"/>

                    <Button Content="Tipos de habitación"
                            Command="{Binding MostrarTiposHabitacionCommand}"
                            Height="45"
                            Margin="0,0,0,8"/>

                    <Button Content="Reservas"
                            Command="{Binding MostrarReservasCommand}"
                            Height="45"
                            Margin="0,0,0,8"/>

                    <Button Content="Minibar"
                            Command="{Binding MostrarMinibarCommand}"
                            Height="45"
                            Margin="0,0,0,8"/>

                    <Button Content="Facturación"
                            Command="{Binding MostrarFacturacionCommand}"
                            Height="45"/>

                </StackPanel>

                <!-- PIE -->
                <TextBlock Grid.Row="2"
                           Text="Sistema Hotelero"
                           Foreground="#9CA3AF"
                           FontSize="11"
                           Margin="20,20,20,20"/>

            </Grid>

        </Border>

        <!-- ===================================================== -->
        <!-- ÁREA PRINCIPAL -->
        <!-- ===================================================== -->

        <Border Grid.Column="1"
                Background="#F5F6F8"
                Padding="10">

            <ContentControl Content="{Binding VistaActual}"/>

        </Border>

    </Grid>

</Window>