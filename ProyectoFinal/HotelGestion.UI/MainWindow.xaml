<Window x:Class="HotelGestion.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hotel Gestión"
        Height="700"
        Width="1100"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TÍTULO -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Gestión de Habitaciones"
                       FontSize="28"
                       FontWeight="SemiBold"/>

            <TextBlock Text="Administración de las habitaciones del hotel"
                       FontSize="14"
                       Foreground="Gray"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- CONTENIDO -->
        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- TABLA -->
            <Grid Grid.Column="0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- BOTÓN ACTUALIZAR -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Margin="0,0,0,10">

                    <Button Content="Actualizar lista"
                            Width="130"
                            Height="35"
                            Command="{Binding CargarCommand}"/>

                </StackPanel>

                <!-- DATAGRID -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Habitaciones}"
                          SelectedItem="{Binding HabitacionSeleccionada}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="ID"
                                            Binding="{Binding HabitacionId}"
                                            Width="55"/>

                        <DataGridTextColumn Header="Número"
                                            Binding="{Binding Numero}"
                                            Width="80"/>

                        <DataGridTextColumn Header="Piso"
                                            Binding="{Binding Piso}"
                                            Width="60"/>

                        <DataGridTextColumn Header="Tipo"
                                            Binding="{Binding TipoHabitacionId}"
                                            Width="70"/>

                        <DataGridTextColumn Header="Estado"
                                            Binding="{Binding Estado}"
                                            Width="120"/>

                        <DataGridTextColumn Header="Descripción"
                                            Binding="{Binding Descripcion}"
                                            Width="*"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

            <!-- FORMULARIO -->
            <Border Grid.Column="2"
                    Padding="20"
                    BorderBrush="LightGray"
                    BorderThickness="1"
                    CornerRadius="8">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <TextBlock Text="Datos de la habitación"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,20"/>

                        <!-- NÚMERO -->
                        <TextBlock Text="Número"
                                   Margin="0,0,0,5"/>

                        <TextBox Text="{Binding Numero, UpdateSourceTrigger=PropertyChanged}"
                                 Height="32"
                                 Margin="0,0,0,15"/>

                        <!-- PISO -->
                        <TextBlock Text="Piso"
                                   Margin="0,0,0,5"/>

                        <TextBox Text="{Binding Piso, UpdateSourceTrigger=PropertyChanged}"
                                 Height="32"
                                 Margin="0,0,0,15"/>

                        <!-- TIPO -->
                        <TextBlock Text="ID Tipo de habitación"
                                   Margin="0,0,0,5"/>

                        <TextBox Text="{Binding TipoHabitacionId, UpdateSourceTrigger=PropertyChanged}"
                                 Height="32"
                                 Margin="0,0,0,15"/>

                        <!-- ESTADO -->
                        <TextBlock Text="Estado"
                                   Margin="0,0,0,5"/>

                        <ComboBox SelectedValue="{Binding Estado, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag" Height="32" Margin="0,0,0,15">
                        
                        <ComboBoxItem Content="Disponible" Tag="Disponible"/>

                        <ComboBoxItem Content="Reservada" Tag="Reservada"/>

                        <ComboBoxItem Content="Ocupada" Tag="Ocupada"/>

                        <ComboBoxItem Content="Limpieza" Tag="Limpieza"/>

                        <ComboBoxItem Content="Mantenimiento" Tag="Mantenimiento"/>

                        </ComboBox>

                        <!-- DESCRIPCIÓN -->
                        <TextBlock Text="Descripción"
                                   Margin="0,0,0,5"/>

                        <TextBox Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}"
                                 Height="80"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,0,0,20"/>

                        <!-- BOTONES -->
                        <Button Content="Nueva habitación"
                                Height="38"
                                Margin="0,0,0,8"
                                Command="{Binding NuevoCommand}"/>

                        <Button Content="Guardar"
                                Height="38"
                                Margin="0,0,0,8"
                                Command="{Binding GuardarCommand}"/>

                        <Button Content="Actualizar"
                                Height="38"
                                Margin="0,0,0,8"
                                Command="{Binding ActualizarCommand}"/>

                        <Button Content="Eliminar"
                                Height="38"
                                Command="{Binding EliminarCommand}"/>

                    </StackPanel>

                </ScrollViewer>

            </Border>

        </Grid>

    </Grid>

</Window>